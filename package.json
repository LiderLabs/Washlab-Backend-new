{
  "name": "@liderlabs/washlab-api",
  "version": "0.1.0",
  "description": "WashLab API (Fastify and PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --project tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "resend": "^6.9.2",
    "svix": "^1.86.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
